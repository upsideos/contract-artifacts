{
  "name": "@upsideos/contract-artifacts-cli",
  "version": "0.1.0",
  "description": "Build, verify, pack, and audit audited contract artifact releases",
  "license": "MIT",
  "bin": {
    "contract-artifacts": "dist/src/cli.js"
  },
  "main": "dist/src/cli.js",
  "types": "dist/src/cli.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
