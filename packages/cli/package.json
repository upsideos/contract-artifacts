  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "abitype": "^1.3.0",
    "eslint-config-love": "^83.0.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-promise": "^7.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "solc": "0.8.28",
    "ts-jest": "^29.2.5",
    "tsx": "^4.7.0",
    "typescript": "~5.6.3"
  }
